        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start((\&quot;Début\&quot;)) --&gt; N1[\&quot;Le candidat prépare son dossier\&quot;]\n    N1 --&gt; D1{{\&quot;Type de demande\&quot;}}\n\n    D1 --&gt;|\&quot;Vente de produits\&quot;| N2a[\&quot;Dossier : CV, CNI,&lt;br&gt;autorisation de vente&lt;br&gt;+ fiche santé alimentaire\&quot;]\n    D1 --&gt;|\&quot;Prestation de services\&quot;| N2b[\&quot;Dossier : CV, CNI,&lt;br&gt;description du service\&quot;]\n    D1 --&gt;|\&quot;Construction\&quot;| N2c[\&quot;Dossier : maquette 3D,&lt;br&gt;business plan\&quot;]\n    D1 --&gt;|\&quot;Local artisanal\&quot;| N2d[\&quot;Dossier : formulaire,&lt;br&gt;pièce d&#39;identité\&quot;]\n    D1 --&gt;|\&quot;Rénovation post-attribution\&quot;| N2e[\&quot;Dossier : maquette,&lt;br&gt;business plan,&lt;br&gt;occupant déjà titulaire&lt;br&gt;d&#39;un contrat\&quot;]\n\n    N2a --&gt; D2{{\&quot;Canal de dépôt\&quot;}}\n    N2b --&gt; D2\n    N2c --&gt; D2\n    N2d --&gt; D2\n    N2e --&gt; D2\n\n    D2 --&gt;|\&quot;Physique\&quot;| N3a[\&quot;Bureau Courrier&lt;br&gt;réceptionne\&quot;]\n    D2 --&gt;|\&quot;Email\&quot;| N3b[\&quot;DCUVE réceptionne&lt;br&gt;directement\&quot;]\n\n    N3a --&gt; N4[\&quot;DCUVE : contrôle de recevabilité&lt;br&gt;(1er point de blocage possible)\&quot;]\n    N3b --&gt; N4\n\n    N4 --&gt; D3{{\&quot;Dossier recevable ?\&quot;}}\n    D3 --&gt;|\&quot;Non\&quot;| N5[\&quot;Demande de compléments&lt;br&gt;au candidat\&quot;]\n    N5 --&gt; D2\n    D3 --&gt;|\&quot;Oui\&quot;| N6[\&quot;Service Technique : étude de faisabilité&lt;br&gt;(analyse maquette / business plan)\&quot;]\n\n    N6 --&gt; D4{{\&quot;Vente alimentaire ?\&quot;}}\n    D4 --&gt;|\&quot;Oui\&quot;| N7[\&quot;Service d&#39;Hygiène externe :&lt;br&gt;avis conforme sur la&lt;br&gt;fiche santé\&quot;]\n    D4 --&gt;|\&quot;Non\&quot;| N8[\&quot;Directeur CROUS-T : décision finale&lt;br&gt;(2e point de blocage, pouvoir global)\&quot;]\n    \n    N7 --&gt; N8\n\n    N8 --&gt; D5{{\&quot;Issue\&quot;}}\n    D5 --&gt;|\&quot;Défavorable\&quot;| N9a[\&quot;Demande rejetée&lt;br&gt;(Fin)\&quot;]\n    D5 --&gt;|\&quot;Mitigée\&quot;| N9b[\&quot;Archivage systématique&lt;br&gt;du dossier&lt;br&gt;(Fin)\&quot;]\n    D5 --&gt;|\&quot;Favorable\&quot;| N10[\&quot;Service Juridique :&lt;br&gt;rédaction du contrat\&quot;]\n\n    N10 --&gt; N11[\&quot;Signature : Directeur CROUS-T&lt;br&gt;+ Candidat&lt;br&gt;Durée 2 ans\&quot;]\n\n    N11 --&gt; D6{{\&quot;Construction&lt;br&gt;impliquée ?\&quot;}}\n\n    D6 --&gt;|\&quot;Oui&lt;br&gt;Financée par le CROUS-T\&quot;| N12a[\&quot;Le CROUS-T finance&lt;br&gt;et réalise\&quot;]\n    D6 --&gt;|\&quot;Oui&lt;br&gt;Financée par le candidat\&quot;| N12b[\&quot;Le candidat finance&lt;br&gt;à ses frais\&quot;]\n    D6 --&gt;|\&quot;Non\&quot;| N12c[\&quot;Non applicable\&quot;]\n\n    N12a --&gt; N13[\&quot;Attribution du local&lt;br&gt;Statut CROUS-T ou&lt;br&gt;Amicale selon le local\&quot;]\n    N12b --&gt; N13\n    N12c --&gt; N13\n\n    N13 --&gt; N14[\&quot;Service Comptable :&lt;br&gt;génération de l&#39;échéancier\&quot;]\n    N14 --&gt; N15[\&quot;FIN ÉTAPE 1 : CONTRAT ACTIF\&quot;]\n\n    N15 --&gt; N16[\&quot;Paiement périodique&lt;br&gt;des échéances\&quot;]\n\n    N16 --&gt; N17{{\&quot;Inspection /&lt;br&gt;Signalement&lt;br&gt;(Agent de terrain, étudiant&lt;br&gt;ou occupant)\&quot;}}\n\n    N17 --&gt;|\&quot;1. INCIDENT TECHNIQUE\&quot;| N18a[\&quot;Agent de terrain traite&lt;br&gt;l&#39;incident\&quot;]\n    N17 --&gt;|\&quot;\&quot;| N18b{{\&quot;Nature constatée\&quot;}}\n    N17 --&gt;|\&quot;3. NON-CONFORMITÉ QHSE\&quot;| N18c[\&quot;Agent HSE contrôle :&lt;br&gt;sécurité sanitaire /&lt;br&gt;technique / électrique\&quot;]\n\n    %% Branche 1 : Incident Technique\n    N18a --&gt; D7{{\&quot;Résolu ?\&quot;}}\n    D7 --&gt;|\&quot;Oui\&quot;| N19a[\&quot;Clôture — délai cible&lt;br&gt;3 à 4 jours\&quot;]\n    D7 --&gt;|\&quot;Non\&quot;| N19b[\&quot;Remontée à la&lt;br&gt;Division Environnement\&quot;]\n    N19b --&gt; N19c[\&quot;Clôture — délai cible&lt;br&gt;3 à 4 jours\&quot;]\n\n    %% Branche 2 : Nature constatée\n    N18b --&gt; N20[\&quot;Bureau / Division Environnement&lt;br&gt;vérifie la situation\&quot;]\n    N20 --&gt; D8{{\&quot;Régularisation possible ?\&quot;}}\n    D8 --&gt;|\&quot;Oui\&quot;| N21a[\&quot;Mise en demeure&lt;br&gt;de régulariser\&quot;]\n    D8 --&gt;|\&quot;Non\&quot;| N21b[\&quot;Expulsion\&quot;]\n\n    %% Branche 3 : Non-conformité QHSE\n    N18c --&gt; D9{{\&quot;Conforme à la&lt;br&gt;fiche HSE ?\&quot;}}\n    D9 --&gt;|\&quot;Oui\&quot;| N22a[\&quot;Mise à jour du score&lt;br&gt;de fidélité QHSE\&quot;]\n    D9 --&gt;|\&quot;Non\&quot;| N22b[\&quot;Graduation des sanctions :&lt;br&gt;Avertissement -&gt; Rappel à l&#39;ordre -&gt;&lt;br&gt;Convocation -&gt; Résiliation/Expulsion\&quot;]\n\n    N22b --&gt; D10{{\&quot;Récidive après délai&lt;br&gt;de correction ?\&quot;}}\n    D10 --&gt;|\&quot;Non, corrigé\&quot;| N23a[\&quot;Fiche HSE : conforme&lt;br&gt;Mise à jour du score&lt;br&gt;QHSE\&quot;]\n    D10 --&gt;|\&quot;Oui\&quot;| N23b[\&quot;Résiliation du contrat&lt;br&gt;par le Directeur&lt;br&gt;CROUS-T\&quot;]\n\n    %% Convergences vers Retour\n    N19a --&gt; N24[\&quot;Retour au contrat actif\&quot;]\n    N19c --&gt; N24\n    N21a --&gt; N24\n    N22a --&gt; N24\n    N23a --&gt; N24\n\n    %% Fin de boucle ou Processus\n    N24 --&gt; D11{{\&quot;Contrat toujours valide ?\&quot;}}\n    D11 --&gt;|\&quot;Oui\&quot;| N16\n    D11 --&gt;|\&quot;Non (expiry / résiliation / départ)\&quot;| End((\&quot;FIN DU PROCESSUS\&quot;))\n    \n    N21b --&gt; End\n    N23b --&gt; End&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZdLetGllsHbivumpivb2-1">
